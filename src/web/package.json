{
  "name": "hockey-index-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "npm run icons",
    "start": "ng serve",
    "prebuild": "npm run icons",
    "build": "ng build",
    "prebuild:staging": "npm run icons",
    "build:staging": "ng build --configuration staging",
    "prewatch": "npm run icons",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run icons",
    "test": "ng test --no-watch && vitest run --config vitest.functions.config.ts",
    "lint": "ng lint && tsc --noEmit -p functions/tsconfig.json",
    "pree2e": "npm run icons",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "icons": "node scripts/subset-icons.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@fontsource/roboto": "^5.3.0",
    "leaflet": "^1.9.4",
    "material-symbols": "^0.47.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.0",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@types/leaflet": "^1.9.22",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "subset-font": "^2.9.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.0.8",
    "wrangler": "^4.147.0"
  }
}
