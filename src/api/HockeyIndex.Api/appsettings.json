{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "ClientIp": {
    "AllowMissingHeader": false
  },
  "Cors": {
    "SpaOrigin": "https://hockeyindex.com"
  },
  "Edge": {
    "Key": ""
  },
  "RateLimiting": {
    "PublicReadPerMinute": 120,
    "PublicReadEdgePerMinute": 600
  },
  "Hmac": {
    "Key": ""
  },
  "Signup": {
    "Mode": "open"
  },
  "Otp": {
    "SmsPerPhonePerHour": 3,
    "SmsPerIpPerHour": 10,
    "SmsPerNpaNxxPerHour": 20,
    "EmailPerAddressPerHour": 3,
    "EmailPerIpPerHour": 10,
    "ChecksPerTargetPer10Minutes": 5,
    "BreakerMaxSendsPerHour": 300,
    "BreakerMinSendsForConversion": 50,
    "BreakerMinConversion": 0.25,
    "BreakerOpenMinutes": 30
  },
  "Twilio": {
    "AccountSid": "",
    "AuthToken": "",
    "VerifyServiceSid": "",
    "CallbackUrl": ""
  },
  "Turnstile": {
    "SecretKey": "",
    "ExpectedHostname": "hockeyindex.com"
  },
  "Postmark": {
    "ServerToken": ""
  },
  "Cloudflare": {
    "ApiToken": "",
    "ZoneId": "",
    "PurgeMode": "tag",
    "PublicApiBaseUrl": "https://api.hockeyindex.com/"
  },
  "Jobs": {
    "Enabled": true
  }
}
