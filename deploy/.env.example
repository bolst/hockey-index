# Images (GHCR). The VPS must be logged in to ghcr.io with a read:packages token.
HI_API_IMAGE=ghcr.io/example-owner/hockey-index-api
HI_MIGRATOR_IMAGE=ghcr.io/example-owner/hockey-index-migrator
HI_API_TAG=sha-000000000000
STAGING_API_TAG=sha-000000000000
CLOUDFLARED_TAG=latest

# Fixed addresses on the internal networks (compose.yaml: 172.30.10.0/24, compose.staging.yaml: 172.30.20.0/24).
HI_OPS_BIND=172.30.10.10
STAGING_OPS_BIND=172.30.20.10

# Prod database. Use URL-safe passwords: they are embedded in connection strings.
POSTGRES_DB=hockeyindex
POSTGRES_PASSWORD=change-me-postgres
HI_MIGRATOR_PASSWORD=change-me-migrator
HI_APP_PASSWORD=change-me-app

# Staging database.
STAGING_POSTGRES_DB=hockeyindex_staging
STAGING_POSTGRES_PASSWORD=change-me-staging-postgres
STAGING_MIGRATOR_PASSWORD=change-me-staging-migrator
STAGING_APP_PASSWORD=change-me-staging-app

# Cloudflare
CLOUDFLARE_TUNNEL_TOKEN=change-me-tunnel-token
CLOUDFLARE_ZONE_ID=00000000000000000000000000000000
CLOUDFLARE_PURGE_TOKEN=change-me-purge-token
STAGING_CLOUDFLARE_PURGE_TOKEN=change-me-staging-purge-token

# Prod API
SIGNUP_MODE=open
HI_EDGE_KEY=change-me-edge-key
HI_EDGE_PREVIOUS_KEY=
HI_HMAC_KEY=change-me-hmac-key-at-least-32-characters
TURNSTILE_SECRET_KEY=change-me-turnstile
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=change-me-twilio
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_CALLBACK_URL=https://api.hockeyindex.com/v1/internal/twilio-usage
MAPBOX_ACCESS_TOKEN=change-me-mapbox
WEBRISK_API_KEY=change-me-webrisk
POSTMARK_SERVER_TOKEN=change-me-postmark

# Staging API (separate provider accounts and keys)
STAGING_SIGNUP_MODE=invite_only
STAGING_EDGE_KEY=change-me-staging-edge-key
STAGING_EDGE_PREVIOUS_KEY=
STAGING_HMAC_KEY=change-me-staging-hmac-key-at-least-32-chars
STAGING_TURNSTILE_SECRET_KEY=change-me-staging-turnstile
STAGING_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STAGING_TWILIO_AUTH_TOKEN=change-me-staging-twilio
STAGING_TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STAGING_TWILIO_CALLBACK_URL=https://api-staging.hockeyindex.com/v1/internal/twilio-usage
STAGING_MAPBOX_ACCESS_TOKEN=change-me-staging-mapbox
STAGING_WEBRISK_API_KEY=change-me-staging-webrisk
STAGING_POSTMARK_SERVER_TOKEN=change-me-staging-postmark

# Observability (Grafana Cloud OTLP)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway.example.grafana.net/otlp
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic change-me

# Backup (age public recipient only; the private key stays off the VPS)
BACKUP_AGE_RECIPIENT=age1xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ENDPOINT=https://0000000000000000.r2.cloudflarestorage.com
R2_BUCKET=hockey-index-backups
R2_ACCESS_KEY_ID=change-me-r2-key-id
R2_SECRET_ACCESS_KEY=change-me-r2-secret
